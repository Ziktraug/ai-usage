{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.svelte",
      "**/*.json",
      "!**/.claude/settings.local.json",
      "!**/.claude/worktrees",
      "!**/.output-build",
      "!**/.svelte-kit",
      "!**/.turbo",
      "!**/.worktrees",
      "!**/dist",
      "!**/node_modules",
      "!**/styled-system"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noSvelteAtDebugTags": "error",
        "noSvelteAtHtmlTags": "error",
        "noSvelteExportLet": "error",
        "noSvelteUnnecessaryStateWrap": "error",
        "useSvelteKitRuneImports": "error"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noBarrelFile": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "noNonNullAssertion": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 1000 }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "../packages/**",
                  "../../packages/**",
                  "../../../packages/**",
                  "../apps/**",
                  "../../apps/**",
                  "../../../apps/**",
                  "@ai-usage/*/src",
                  "@ai-usage/*/src/**"
                ],
                "message": "Use workspace package imports and public package exports instead of relative workspace paths or private src paths."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noEqualsToNull": "off",
        "noReturnAssign": "off",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      "includes": ["packages/report-core/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@ai-usage/*",
                      "../packages/**",
                      "../../packages/**",
                      "../../../packages/**",
                      "../apps/**",
                      "../../apps/**",
                      "../../../apps/**",
                      "@ai-usage/*/src",
                      "@ai-usage/*/src/**"
                    ],
                    "message": "packages/report-core is pure domain code and cannot import workspace runtime packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/skills/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@ai-usage/*",
                      "../packages/**",
                      "../../packages/**",
                      "../../../packages/**",
                      "../apps/**",
                      "../../apps/**",
                      "../../../apps/**",
                      "@ai-usage/*/src",
                      "@ai-usage/*/src/**"
                    ],
                    "message": "packages/skills is a self-contained local control plane and cannot import workspace runtime packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/lib/features/report/overview/overview-page.svelte",
        "apps/web/src/lib/features/report/overview/executive-overview.svelte"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../packages/**",
                      "../../packages/**",
                      "../../../packages/**",
                      "../apps/**",
                      "../../apps/**",
                      "../../../apps/**",
                      "@ai-usage/*/src",
                      "@ai-usage/*/src/**"
                    ],
                    "message": "Use workspace package imports and public package exports instead of relative workspace paths or private src paths."
                  },
                  {
                    "group": [
                      "@tanstack/*",
                      "@orpc/*",
                      "**/rpc/**",
                      "#lib/rpc/**",
                      "**/query/**",
                      "#lib/query/**",
                      "**/server/**",
                      "#lib/server/**"
                    ],
                    "message": "The Overview composition is presentation-only: its live and synthetic owners acquire the report and pass it in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/lib/features/skills/shell/skills-shell.svelte"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "../../../query/hydration-context.svelte": {
                    "allowImportNames": ["useWebQueryHydrationContext"],
                    "message": "The Skills shell gates on the hydration context's coverage alone; it binds no other hydration helper."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "../packages/**",
                      "../../packages/**",
                      "../../../packages/**",
                      "../apps/**",
                      "../../apps/**",
                      "../../../apps/**",
                      "@ai-usage/*/src",
                      "@ai-usage/*/src/**"
                    ],
                    "message": "Use workspace package imports and public package exports instead of relative workspace paths or private src paths."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/svelte",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ]
}
