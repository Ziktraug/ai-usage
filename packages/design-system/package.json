{
  "name": "@ai-usage/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./svelte": {
      "types": "./src/svelte.ts",
      "import": "./src/svelte.ts"
    },
    "./svelte/passive": {
      "types": "./src/svelte-passive.ts",
      "import": "./src/svelte-passive.ts"
    },
    "./svelte/cell-with-provenance": {
      "types": "./src/svelte/overlays/cell-with-provenance.svelte",
      "import": "./src/svelte/overlays/cell-with-provenance.svelte"
    },
    "./svelte/checkbox": {
      "types": "./src/svelte/controls/checkbox.svelte",
      "import": "./src/svelte/controls/checkbox.svelte"
    },
    "./svelte/drawer": {
      "types": "./src/svelte/overlays/drawer.svelte",
      "import": "./src/svelte/overlays/drawer.svelte"
    },
    "./svelte/harness-badge": {
      "types": "./src/svelte/controls/harness-badge.svelte",
      "import": "./src/svelte/controls/harness-badge.svelte"
    },
    "./svelte/multi-select": {
      "types": "./src/svelte/compound/multi-select.svelte",
      "import": "./src/svelte/compound/multi-select.svelte"
    },
    "./svelte/popover": {
      "types": "./src/svelte/overlays/popover.svelte",
      "import": "./src/svelte/overlays/popover.svelte"
    },
    "./svelte/provenance-marker": {
      "types": "./src/svelte/overlays/provenance-marker.svelte",
      "import": "./src/svelte/overlays/provenance-marker.svelte"
    },
    "./svelte/segmented-control": {
      "types": "./src/svelte/compound/segmented-control.svelte",
      "import": "./src/svelte/compound/segmented-control.svelte"
    },
    "./svelte/tabs": {
      "types": "./src/svelte/compound/tabs.svelte",
      "import": "./src/svelte/compound/tabs.svelte"
    },
    "./svelte/toggle": {
      "types": "./src/svelte/controls/toggle.svelte",
      "import": "./src/svelte/controls/toggle.svelte"
    },
    "./svelte/tooltip": {
      "types": "./src/svelte/overlays/tooltip.svelte",
      "import": "./src/svelte/overlays/tooltip.svelte"
    },
    "./preset": {
      "types": "./src/preset.ts",
      "import": "./src/preset.ts"
    },
    "./report": {
      "types": "./src/report.ts",
      "import": "./src/report.ts"
    },
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "import": "./styled-system/css/index.mjs"
    },
    "./panda.buildinfo.json": "./styled-system/panda.buildinfo.json",
    "./styles.css": "./styled-system/styles.css"
  },
  "peerDependencies": {
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@pandacss/dev": "1.12.0",
    "svelte": "5.56.8"
  },
  "scripts": {
    "ship": "CI=1 bun --bun panda ship --outfile styled-system/panda.buildinfo.json --silent",
    "build": "CI=1 bun --bun panda codegen --silent && CI=1 bun --bun panda cssgen --silent && bun run ship && bun --bun tsc --noEmit",
    "check": "CI=1 bun --bun panda codegen --silent && CI=1 bun --bun panda cssgen --silent && bun run ship && bun --bun tsc --noEmit",
    "test": "bun test",
    "test:browser": "bun src/svelte/controls/controls.browser.ts && bun src/svelte/overlays/overlays.browser.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ark-ui/svelte": "5.22.1"
  }
}
