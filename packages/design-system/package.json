{
  "name": "@ai-usage/design-system",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./svelte": {
      "types": "./src/svelte.ts",
      "import": "./src/svelte.ts"
    },
    "./preset": {
      "types": "./src/preset.ts",
      "import": "./src/preset.ts"
    },
    "./report": {
      "types": "./src/report.ts",
      "import": "./src/report.ts"
    },
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./styles.css": "./styled-system/styles.css",
    "./panda/*": "./styled-system/panda/*",
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "CI=1 bun --bun panda codegen --clean --log-level warn && CI=1 bun --bun panda cssgen --log-level warn && bun run lib && bun --bun tsc --noEmit",
    "check": "CI=1 bun --bun panda codegen --clean --log-level warn && CI=1 bun --bun panda cssgen --log-level warn && bun run lib && bun --bun tsc --noEmit",
    "format": "biome format --write .",
    "lib": "CI=1 bun --bun panda lib --outdir styled-system --log-level warn",
    "lint": "biome check .",
    "test": "bun test",
    "test:browser": "bun src/svelte/controls/controls.browser.ts && bun src/svelte/overlays/overlays.browser.ts"
  },
  "dependencies": {
    "@ark-ui/svelte": "5.24.3"
  },
  "devDependencies": {
    "@pandacss/dev": "2.3.0",
    "@pandacss/preset-base": "2.3.0",
    "@pandacss/preset-panda": "2.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "svelte": "5.57.2"
  }
}
