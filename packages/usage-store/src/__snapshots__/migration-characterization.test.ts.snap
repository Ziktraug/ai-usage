  "68dd5a8c6cc138aa": 
"
  CREATE TABLE IF NOT EXISTS review_attempts (
    attempt_id TEXT PRIMARY KEY,
    machine_id TEXT NOT NULL,
    idempotency_key TEXT NOT NULL,
    action TEXT NOT NULL CHECK (action IN ('read-only-review')),
    target_harness TEXT NOT NULL,
    source_session_id TEXT NOT NULL,
    desktop_session_id TEXT,
    checkout_path TEXT,
    checkout_origin TEXT CHECK (checkout_origin IS NULL OR checkout_origin IN ('desktop-worktree', 'desktop-cwd', 'served-session')),
    project_label TEXT,
    session_title TEXT,
    candidate_id TEXT NOT NULL,
    executor_harness TEXT NOT NULL CHECK (executor_harness IN ('claude-code', 'codex')),
    declaration_json TEXT,
    state TEXT NOT NULL CHECK (state IN ('requested', 'starting', 'running', 'finished', 'failed', 'refused', 'lost')),
    requested_at TEXT NOT NULL,
    started_at TEXT,
    ended_at TEXT,
    updated_at TEXT NOT NULL,
    native_session_id TEXT,
    native_turn_id TEXT,
    stop_requested_at TEXT,
    stop_confirmed_at TEXT,
    pid INTEGER,
    exit_code INTEGER,
    result_kind TEXT CHECK (result_kind IS NULL OR result_kind IN ('review', 'error', 'timeout')),
    result_excerpt TEXT,
    num_turns INTEGER,
    duration_ms INTEGER,
    validations_json TEXT NOT NULL DEFAULT '[]',
    acceptance TEXT NOT NULL DEFAULT 'pending' CHECK (acceptance IN ('pending', 'accepted', 'rejected')),
    failure_reason TEXT,
    launch_session_id TEXT,
    released_at TEXT,
    release_evidence TEXT CHECK (release_evidence IS NULL OR release_evidence IN ('process-absent', 'outcome-recorded-late', 'recorded-before-reservations', 'operator-declared-ended')),
    scope_json TEXT,
    guarantee_json TEXT,
    base_sha TEXT,
    head_sha TEXT
);
  
  CREATE INDEX IF NOT EXISTS idx_review_attempts_target
    ON review_attempts(machine_id, target_harness, source_session_id, requested_at DESC);

"
,
  "6999f47ec6e159e7": 
"
  CREATE TABLE IF NOT EXISTS pull_request_observations (
    id INTEGER PRIMARY KEY,
    machine_id TEXT NOT NULL,
    host TEXT NOT NULL,
    repository TEXT NOT NULL,
    number INTEGER NOT NULL CHECK (number > 0),
    observed_at TEXT NOT NULL,
    outcome TEXT NOT NULL,
    outcome_message TEXT,
    account_label TEXT,
    state TEXT,
    draft INTEGER CHECK (draft IN (0, 1)),
    review_decision TEXT,
    merged_at TEXT,
    updated_at TEXT,
    title TEXT,
    url TEXT,
    head_ref TEXT,
    base_ref TEXT,
    checks_rollup TEXT,
    discovery_role TEXT,
    mergeable TEXT,
    merge_state_status TEXT,
    created_at TEXT,
    closed_at TEXT,
    unresolved_review_threads INTEGER,
    cross_repository INTEGER,
    history TEXT
  );
  CREATE UNIQUE INDEX IF NOT EXISTS idx_pull_request_observations_identity
    ON pull_request_observations(machine_id, host, repository, number, observed_at DESC);

  CREATE TABLE IF NOT EXISTS checkout_status_observations (
    id INTEGER PRIMARY KEY,
    machine_id TEXT NOT NULL,
    checkout_path TEXT NOT NULL,
    observed_at TEXT NOT NULL,
    outcome TEXT NOT NULL,
    branch TEXT,
    head_sha TEXT,
    upstream TEXT,
    ahead INTEGER CHECK (ahead IS NULL OR ahead >= 0),
    behind INTEGER CHECK (behind IS NULL OR behind >= 0),
    staged_count INTEGER CHECK (staged_count IS NULL OR staged_count >= 0),
    modified_count INTEGER CHECK (modified_count IS NULL OR modified_count >= 0),
    untracked_count INTEGER CHECK (untracked_count IS NULL OR untracked_count >= 0),
    last_commit_at TEXT,
    counts_changed_at TEXT,
    dirty INTEGER CHECK (dirty IN (0, 1))
  );
  CREATE UNIQUE INDEX IF NOT EXISTS idx_checkout_status_observations_identity
    ON checkout_status_observations(machine_id, checkout_path, observed_at DESC);

  CREATE TABLE IF NOT EXISTS jira_issue_observations (
    id INTEGER PRIMARY KEY,
    machine_id TEXT NOT NULL,
    issue_key TEXT NOT NULL,
    observed_at TEXT NOT NULL,
    outcome TEXT NOT NULL,
    outcome_message TEXT,
    status TEXT,
    status_category TEXT,
    summary TEXT,
    updated_at TEXT,
    assignee_label TEXT,
    sprint TEXT,
    parent_key TEXT,
    comment_count INTEGER CHECK (comment_count IS NULL OR comment_count >= 0),
    comments_json TEXT NOT NULL,
    url TEXT,
    handed_off INTEGER
  );
  CREATE UNIQUE INDEX IF NOT EXISTS idx_jira_issue_observations_identity
    ON jira_issue_observations(machine_id, issue_key, observed_at DESC);

  CREATE TABLE IF NOT EXISTS jira_sync_state (
    machine_id TEXT PRIMARY KEY,
    state_json TEXT NOT NULL
  ) WITHOUT ROWID;

  CREATE TABLE IF NOT EXISTS work_fact_run_state (
    source_id TEXT PRIMARY KEY,
    machine_id TEXT NOT NULL,
    ran_at TEXT NOT NULL,
    observed INTEGER NOT NULL CHECK (observed >= 0),
    failed INTEGER NOT NULL CHECK (failed >= 0),
    disabled INTEGER NOT NULL CHECK (disabled IN (0, 1)),
    message TEXT,
    outcome_code TEXT CHECK (outcome_code IS NULL OR outcome_code = 'unauthenticated')
  ) WITHOUT ROWID;
"
