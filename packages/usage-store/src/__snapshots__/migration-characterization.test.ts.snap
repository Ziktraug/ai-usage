"
  CREATE TABLE IF NOT EXISTS delegation_qualifications (
    qualification_id TEXT PRIMARY KEY,
    machine_id TEXT NOT NULL,
    request_digest TEXT NOT NULL,
    policy_revision TEXT NOT NULL,
    purpose TEXT NOT NULL CHECK (purpose IN ('delegation', 'simulation')),
    qualified_at TEXT NOT NULL,
    valid_until TEXT NOT NULL,
    qualification_json TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS idx_delegation_qualifications_machine
    ON delegation_qualifications(machine_id, qualified_at DESC);

  CREATE TABLE IF NOT EXISTS delegation_jobs (
    job_id TEXT PRIMARY KEY,
    machine_id TEXT NOT NULL,
    idempotency_key TEXT NOT NULL,
    request_digest TEXT NOT NULL,
    selection_digest TEXT,
    request_json TEXT NOT NULL,
    action TEXT NOT NULL,
    task_category TEXT NOT NULL,
    checkout_path TEXT,
    base_sha TEXT,
    head_sha TEXT,
    retry_of TEXT,
    attempt_number INTEGER NOT NULL CHECK (attempt_number >= 1),
    qualification_id TEXT,
    qualification_json TEXT,
    selection_json TEXT,
    route_id TEXT,
    pool_id TEXT,
    executor_harness TEXT CHECK (executor_harness IS NULL OR executor_harness IN ('claude-code', 'codex')),
    account_scope TEXT,
    context TEXT CHECK (context IS NULL OR context IN ('professional', 'personal')),
    model_requested TEXT,
    model_resolved TEXT,
    effort TEXT,
    harness_version TEXT,
    state TEXT NOT NULL CHECK (state IN ('requested', 'starting', 'running', 'finished', 'failed', 'cancelled', 'refused', 'abstained', 'lost')),
    refusal_reason TEXT CHECK (refusal_reason IS NULL OR refusal_reason IN ('invalid-request', 'action-unsupported', 'scope-unsupported', 'scope-unavailable', 'scope-changed', 'checkout-unavailable', 'checkout-not-admitted', 'no-admissible-route', 'route-not-admissible', 'qualification-unknown', 'qualification-expired', 'qualification-mismatch', 'policy-changed', 'identity-changed', 'target-reserved', 'pool-busy', 'attempts-exhausted', 'idempotency-conflict', 'executor-unavailable', 'recursive-delegation', 'engine-stopping')),
    failure_reason TEXT,
    requested_at TEXT NOT NULL,
    started_at TEXT,
    ended_at TEXT,
    updated_at TEXT NOT NULL,
    cancel_requested_at TEXT,
    launch_marker TEXT,
    pid INTEGER,
    native_session_id TEXT,
    exit_code INTEGER,
    result_kind TEXT CHECK (result_kind IS NULL OR result_kind IN ('review', 'unstructured', 'error', 'timeout', 'cancelled')),
    result_json TEXT,
    usage_json TEXT,
    guarantee_json TEXT,
    scope_json TEXT,
    executed_scope_json TEXT,
    released_at TEXT,
    release_evidence TEXT CHECK (release_evidence IS NULL OR release_evidence IN ('process-absent', 'outcome-recorded-late', 'operator-declared-ended')),
    trace_version INTEGER NOT NULL,
    UNIQUE (machine_id, idempotency_key)
  );
  CREATE INDEX IF NOT EXISTS idx_delegation_jobs_machine_state
    ON delegation_jobs(machine_id, state, requested_at DESC);
  CREATE INDEX IF NOT EXISTS idx_delegation_jobs_target
    ON delegation_jobs(machine_id, checkout_path, base_sha, head_sha);
  CREATE INDEX IF NOT EXISTS idx_delegation_jobs_pool
    ON delegation_jobs(machine_id, pool_id);
  CREATE INDEX IF NOT EXISTS idx_delegation_jobs_retry_of
    ON delegation_jobs(retry_of);
  CREATE UNIQUE INDEX IF NOT EXISTS idx_delegation_jobs_reserved_target
    ON delegation_jobs(machine_id, action, checkout_path, base_sha, head_sha)
    WHERE (state IN ('requested', 'starting', 'running') OR (state = 'lost' AND released_at IS NULL));

  CREATE TABLE IF NOT EXISTS delegation_evaluations (
    evaluation_id TEXT PRIMARY KEY,
    job_id TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('verification', 'acceptance')),
    verdict TEXT NOT NULL CHECK (verdict IN ('confirmed', 'partially-confirmed', 'refuted', 'inconclusive', 'accepted', 'rejected', 'taken-over')),
    author TEXT NOT NULL CHECK (author IN ('operator', 'calling-model', 'automated-check')),
    author_label TEXT,
    note TEXT,
    checks_json TEXT NOT NULL DEFAULT '[]',
    recorded_at TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS idx_delegation_evaluations_job
    ON delegation_evaluations(job_id, recorded_at DESC);
"
