{
  "name": "@ai-usage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application": "./src/application.ts",
    "./config": "./src/config.ts",
    "./main": "./src/main.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "dev": "bun --no-env-file --watch src/main.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "bun --no-env-file src/main.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-usage/identity": "workspace:*",
    "@ai-usage/platform-core": "workspace:*",
    "@ai-usage/postgres-store": "workspace:*",
    "@ai-usage/replication-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
