{
  "extends": "./.svelte-kit/check/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun", "vite/client"]
  },
  "include": [
    ".svelte-kit/check/ambient.d.ts",
    ".svelte-kit/check/env.d.ts",
    ".svelte-kit/check/non-ambient.d.ts",
    ".svelte-kit/check/types/**/$types.d.ts",
    "src/**/*.svelte",
    "src/**/*.ts",
    "panda.config.ts",
    "vite-*.ts",
    "vite.config.ts"
  ]
}
