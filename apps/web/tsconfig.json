{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "rootDirs": [".", "./.svelte-kit/check/types"],
    "skipLibCheck": true,
    "strict": true,
    "types": ["$app/types", "bun", "vite/client"]
  },
  "include": [
    ".svelte-kit/check/types/**/$types.d.ts",
    "src/**/*.svelte",
    "src/**/*.ts",
    "bundle/**/*.ts",
    "browser-request-abort-allowance.test.ts",
    "browser-script-response-allowance.test.ts",
    "panda.config.ts",
    "server-state-*.test.ts",
    "production-clock.test.ts",
    "rpc-test-transport.test.ts",
    "sveltekit-*.ts",
    "vite-*.ts",
    "vite.config.ts"
  ]
}
