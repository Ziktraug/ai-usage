{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ai-usage/design-system#build": {
      "dependsOn": ["^build"],
      "outputs": ["styled-system/**"]
    },
    "@ai-usage/design-system#check": {
      "dependsOn": ["^build"],
      "outputs": ["styled-system/**"]
    },
    "@ai-usage/web#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [".output-build/nitro/**", "styled-system/**"]
    },
    "@ai-usage/web#check": {
      "dependsOn": ["^build"],
      "outputs": ["styled-system/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "@ai-usage/web#dev": {
      "cache": false,
      "dependsOn": ["dev:prepare"],
      "passThroughEnv": [
        "AI_USAGE_CODEX_FIXTURE_LOG",
        "AI_USAGE_DATABASE_PATH",
        "AI_USAGE_ENGINE_INSTANCE_ID",
        "AI_USAGE_ENGINE_PORT",
        "AI_USAGE_ENGINE_STATE_DIR",
        "AI_USAGE_HOME",
        "AI_USAGE_LOG_DIR",
        "AI_USAGE_PERF",
        "AI_USAGE_ROOT_DIR",
        "AI_USAGE_TEMP_ROOT",
        "BROWSER",
        "CI",
        "HOME",
        "HOST",
        "NITRO_HOST",
        "NITRO_PORT",
        "NITRO_SSL_CERT",
        "NITRO_SSL_KEY",
        "NODE_ENV",
        "NO_COLOR",
        "PATH",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
        "PORT",
        "SERVER_SHUTDOWN_TIMEOUT",
        "TMPDIR",
        "TZ",
        "VITE_AI_USAGE_DEMO",
        "VITE_AI_USAGE_E2E",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ],
      "persistent": true
    },
    "@ai-usage/usage-engine#dev": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/effect-runtime/package.json",
        "$TURBO_ROOT$/packages/effect-runtime/src/**",
        "$TURBO_ROOT$/packages/local-collectors/package.json",
        "$TURBO_ROOT$/packages/local-collectors/src/**",
        "$TURBO_ROOT$/packages/report-core/package.json",
        "$TURBO_ROOT$/packages/report-core/src/**",
        "$TURBO_ROOT$/packages/report-data/package.json",
        "$TURBO_ROOT$/packages/report-data/src/**",
        "$TURBO_ROOT$/packages/skills/package.json",
        "$TURBO_ROOT$/packages/skills/src/**",
        "$TURBO_ROOT$/packages/usage-engine-control/package.json",
        "$TURBO_ROOT$/packages/usage-engine-control/src/**",
        "$TURBO_ROOT$/packages/usage-engine-runtime/package.json",
        "$TURBO_ROOT$/packages/usage-engine-runtime/src/**",
        "$TURBO_ROOT$/packages/usage-merge/package.json",
        "$TURBO_ROOT$/packages/usage-merge/src/**",
        "$TURBO_ROOT$/packages/usage-store/package.json",
        "$TURBO_ROOT$/packages/usage-store/src/**"
      ],
      "interruptible": false,
      "passThroughEnv": [
        "AI_USAGE_CODEX_FIXTURE_LOG",
        "AI_USAGE_DATABASE_PATH",
        "AI_USAGE_ENGINE_INSTANCE_ID",
        "AI_USAGE_ENGINE_PORT",
        "AI_USAGE_ENGINE_STATE_DIR",
        "AI_USAGE_HOME",
        "AI_USAGE_LOG_DIR",
        "AI_USAGE_PERF",
        "AI_USAGE_ROOT_DIR",
        "AI_USAGE_TEMP_ROOT",
        "BROWSER",
        "CI",
        "HOME",
        "HOST",
        "NITRO_HOST",
        "NITRO_PORT",
        "NITRO_SSL_CERT",
        "NITRO_SSL_KEY",
        "NODE_ENV",
        "NO_COLOR",
        "PATH",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
        "PORT",
        "SERVER_SHUTDOWN_TIMEOUT",
        "TMPDIR",
        "TZ",
        "VITE_AI_USAGE_DEMO",
        "VITE_AI_USAGE_E2E",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ],
      "persistent": true
    },
    "@ai-usage/web#dev:prepare": {
      "cache": false,
      "dependsOn": ["@ai-usage/design-system#build"],
      "outputs": ["styled-system/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "quota": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
