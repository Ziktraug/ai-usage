{
  "name": "ai-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-usage": "./apps/cli/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark:authorization": "AI_USAGE_RUN_POSTGRES_TESTS=1 bun tools/benchmark-authorization.postgres.ts",
    "build": "turbo run build",
    "check": "ultracite check",
    "cli": "bun apps/cli/src/main.ts",
    "demo": "bun --no-env-file tools/run-web-demo.ts",
    "dev": "AI_USAGE_ROOT_DIR=$PWD exec turbo watch dev --filter @ai-usage/usage-engine --filter @ai-usage/web --ui=stream --log-order=stream --log-prefix=task",
    "dev:engine": "AI_USAGE_ROOT_DIR=$PWD exec turbo watch dev --filter @ai-usage/usage-engine --ui=stream --log-order=stream --log-prefix=task",
    "dev:once": "bun run --cwd apps/web dev:standalone",
    "dev:platform": "bun --no-env-file tools/run-connected-server.ts",
    "dev:server": "exec turbo watch dev --filter @ai-usage/server --ui=stream --log-order=stream --log-prefix=task",
    "fix": "ultracite fix",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false --only=lint/style/noRestrictedImports . && bun tools/check-workspace-relative-paths.ts && bun tools/check-public-package-exports.ts && bun tools/check-package-boundaries.ts && bun tools/check-svelte-style-shadowing.ts && bun tools/check-design-export-consumers.ts",
    "mcp": "bun --no-env-file apps/mcp/src/main.ts",
    "mcp:register:codex": "bun --no-env-file apps/mcp/src/register.ts codex",
    "prepare": "lefthook install",
    "preview": "bun run --cwd apps/web preview",
    "start": "bun --no-env-file tools/start-production.ts",
    "start:server": "bun --no-env-file apps/server/src/main.ts",
    "start:web-only": "bun --no-env-file apps/web/start.mjs",
    "test": "bun run test:packages && bun run test:tools",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e-demo": "bun run --cwd apps/web test:e2e-demo",
    "test:e2e-memory": "bun run --cwd apps/web test:e2e-memory",
    "test:e2e-production": "bun run --cwd apps/web test:e2e-production",
    "test:local-platform": "bun --no-env-file tools/check-local-platform-independence.ts",
    "test:packages": "turbo run test --concurrency=1",
    "test:postgres": "AI_USAGE_RUN_POSTGRES_TESTS=1 bun test tools/pg-harness.postgres.test.ts tools/postgres-store.postgres.test.ts tools/identity-kernel.postgres.test.ts tools/authorization.postgres.test.ts tools/device-enrollment.postgres.test.ts tools/authentication.postgres.test.ts tools/memory.postgres.test.ts tools/replication.postgres.test.ts tools/replication-e2e.postgres.test.ts packages/postgres-store apps/server",
    "test:setup-loopback": "bun tools/check-setup-loopback.ts",
    "test:tools": "bun test tools",
    "test:web-bundle": "bun run --cwd apps/web test:bundle",
    "test:web-client-manifest": "bun tools/check-web-client-manifest.ts apps/web/.svelte-kit/build/private/client-modules.json",
    "test:web-dev-build-isolation": "bun tools/check-web-dev-build-isolation.ts",
    "test:web-production": "bun tools/check-web-production-start.ts",
    "typecheck": "turbo run check && bun tools/check-typescript-coverage.ts && tsc -p tsconfig.tools.json --noEmit",
    "update": "bun update --interactive --recursive",
    "verify": "bun run check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@ai-usage/authorization": "workspace:*",
    "@ai-usage/identity": "workspace:*",
    "@ai-usage/local-machine": "workspace:*",
    "@ai-usage/mcp-adapter": "workspace:*",
    "@ai-usage/memory-search": "workspace:*",
    "@ai-usage/memory-service": "workspace:*",
    "@ai-usage/memory-sqlite": "workspace:*",
    "@ai-usage/platform-core": "workspace:*",
    "@ai-usage/postgres-store": "workspace:*",
    "@ai-usage/project-application": "workspace:*",
    "@ai-usage/replication-client": "workspace:*",
    "@ai-usage/replication-outbox": "workspace:*",
    "@ai-usage/replication-protocol": "workspace:*",
    "@ai-usage/report-core": "workspace:*",
    "@ai-usage/server": "workspace:*",
    "@ai-usage/usage-engine-control": "workspace:*",
    "@ai-usage/usage-engine-runtime": "workspace:*",
    "@ai-usage/usage-store": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "effect": "^4.0.5",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "pg": "8.23.1",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.3"
}
