{
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "1.3.13",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.8",
    "turbo": "^2.9.18",
    "typescript": "6.0.3",
    "ultracite": "7.8.3"
  },
  "name": "ai-usage",
  "scripts": {
    "cli": "bun apps/cli/src/main.ts",
    "dev": "AI_USAGE_ROOT_DIR=$PWD exec turbo watch dev --filter @ai-usage/usage-engine --filter @ai-usage/web --ui=stream --log-order=stream --log-prefix=task",
    "dev:engine": "AI_USAGE_ROOT_DIR=$PWD exec turbo watch dev --filter @ai-usage/usage-engine --ui=stream --log-order=stream --log-prefix=task",
    "dev:once": "bun run --cwd apps/web dev:standalone",
    "demo": "bun --no-env-file tools/run-web-demo.ts",
    "preview": "bun run --cwd apps/web preview",
    "start": "bun --no-env-file tools/start-production.ts",
    "start:web-only": "bun --no-env-file apps/web/start.mjs",
    "build": "turbo run build",
    "check": "ultracite check",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false --only=lint/style/noRestrictedImports . && bun tools/check-workspace-relative-paths.ts && bun tools/check-public-package-exports.ts && bun tools/check-package-boundaries.ts",
    "test": "bun run test:packages && bun run test:tools",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e-demo": "bun run --cwd apps/web test:e2e-demo",
    "test:e2e-production": "bun run --cwd apps/web test:e2e-production",
    "test:packages": "turbo run test --concurrency=1",
    "test:setup-loopback": "bun tools/check-setup-loopback.ts",
    "test:tools": "bun test tools",
    "test:web-dev-build-isolation": "bun tools/check-web-dev-build-isolation.ts",
    "test:web-client-manifest": "bun tools/check-web-client-manifest.ts apps/web/.svelte-kit/build/private/client-modules.json",
    "test:web-migration-parity": "bun --no-env-file tools/check-web-migration-parity.ts --require-complete",
    "test:web-production": "bun tools/check-web-production-start.ts",
    "typecheck": "bun tools/check-typescript-coverage.ts && tsc -p tsconfig.tools.json --noEmit && turbo run check",
    "update": "bun update --interactive --recursive",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "packageManager": "bun@1.3.13",
  "bin": {
    "ai-usage": "./apps/cli/src/main.ts"
  }
}
